{
  "title": "Outbox  \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0441\u043e\u0431\u044b\u0442\u0438\u0439 \u0432 Kafka",
  "uid": "outbox-sli",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Lost-event check: created \u2212 published (30m)",
      "description": "\u0420\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 rate(created) \u0438 rate(published) \u0437\u0430 30 \u043c\u0438\u043d\u0443\u0442 = \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u0435 \u043d\u0430 \u043f\u043e\u0442\u0435\u0440\u044e \u0441\u043e\u0431\u044b\u0442\u0438\u0439",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(increase(outbox_events_new_total[30m])) - sum(increase(outbox_events_published_total[30m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Freshness SLI: p99 delivery < 60s",
      "description": "histogram_quantile(0.99, rate(outbox_delivery_seconds_bucket[5m])) \u2014 \u0446\u0435\u043b\u044c < 60",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(outbox_delivery_seconds_bucket[5m])) by (le))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput: created vs published (1m)",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (event_type) (rate(outbox_events_new_total[1m])) or sum by (event_type) (rate(outbox_events_published_total[1m]))",
          "legendFormat": "created {{event_type}}"
        },
        {
          "expr": "sum(rate(outbox_events_published_total[1m])) by (event_type)",
          "legendFormat": "published {{event_type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "outbox_pending{status} \u2014 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043e\u0447\u0435\u0440\u0435\u0434\u0438",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(outbox_pending) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Delivery latency p50 / p95 / p99",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(outbox_delivery_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(outbox_delivery_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(outbox_delivery_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "\u0417\u0434\u043e\u0440\u043e\u0432\u044c\u0435 publisher-\u0430",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(outbox_send_failures_total[5m])) by (error) or vector(0)",
          "legendFormat": "send_failures {{error}}"
        },
        {
          "expr": "sum(rate(outbox_events_rejected_total[5m])) by (event_type) or vector(0)",
          "legendFormat": "rejected {{event_type}}"
        },
        {
          "expr": "sum(rate(outbox_retries_total[5m])) or vector(0)",
          "legendFormat": "retries"
        },
        {
          "expr": "sum(rate(outbox_lease_lost_total[5m])) or vector(0)",
          "legendFormat": "lease_lost"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "\u0412\u043e\u0437\u0440\u0430\u0441\u0442 \u0441\u0430\u043c\u043e\u0433\u043e \u0441\u0442\u0430\u0440\u043e\u0433\u043e NEW \u0441\u043e\u0431\u044b\u0442\u0438\u044f",
      "description": "\u00ab\u0417\u0430\u0441\u0442\u0440\u044f\u0432\u0448\u0430\u044f \u043e\u0447\u0435\u0440\u0435\u0434\u044c\u00bb \u2014 \u0432\u0438\u0434\u0435\u043d \u0434\u0430\u0436\u0435 \u0431\u0435\u0437 \u043a\u0430\u0443\u043d\u0442\u0435\u0440\u043e\u0432",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "outbox_oldest_new_age_seconds",
          "legendFormat": "oldest NEW"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "yellow",
              "value": 60
            },
            {
              "color": "red",
              "value": 300
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "\u041e\u0442\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0435 \u0440\u0435\u0442\u0440\u0430\u0438 (next_attempt_at \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043c)",
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "outbox_deferred_retries",
          "legendFormat": "deferred retries"
        }
      ],
      "fieldConfig": {
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "orange",
              "value": 1
            }
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Batch size / poll duration",
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "outbox_publisher_batch_size",
          "legendFormat": "batch_size"
        },
        {
          "expr": "rate(outbox_publisher_poll_seconds_sum[5m]) / clamp_min(rate(outbox_publisher_poll_seconds_count[5m]), 1e-9)",
          "legendFormat": "poll mean"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kafka producer (auto)",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(kafka_producer_record_send_total[5m])) or vector(0)",
          "legendFormat": "records sent/s"
        },
        {
          "expr": "sum(rate(kafka_producer_record_error_total[5m])) or vector(0)",
          "legendFormat": "record errors/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API /v1/transfer + JVM health (auto)",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=\"/v1/transfer\"}[5m])) by (le))",
          "legendFormat": "transfer p99"
        },
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[5m])",
          "legendFormat": "gc pause rate"
        },
        {
          "expr": "process_cpu_usage",
          "legendFormat": "cpu"
        },
        {
          "expr": "sum(hikaricp_connections_pending)",
          "legendFormat": "hikari pending"
        }
      ]
    }
  ]
}